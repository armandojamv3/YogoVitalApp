# Copy this file to .env and fill values
# Use the PostgreSQL connection string from your Supabase project settings.
# Example format:
# DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=change_this_to_a_strong_secret
PORT=4000

# SMTP settings for verification emails
# Example for SendGrid SMTP API: set accordingly or use your SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@yourdomain.com

# Base URL used to build verification links (include protocol and domain)
# Example: https://app.yourdomain.com
APP_BASE_URL=http://localhost:8080

# SendGrid (preferred) - API key
SENDGRID_API_KEY=
# Optional: override From address for SendGrid
SENDGRID_FROM=no-reply@yourdomain.com

# Notes:
# - Copy this file to .env
# - Do not commit .env to your repository
