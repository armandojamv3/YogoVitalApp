<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana mientras arranca el proceso. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12 en adelante dibuja el icono de la app centrado sobre
             este color. Sin esta línea usa el del tema, que en modo oscuro
             es negro: de ahí el logo sobre fondo negro. -->
        <item name="android:windowSplashScreenBackground">@color/fondo_arranque</item>
    </style>

    <!-- Tema de la ventana una vez arrancado el proceso, detrás de la UI de
         Flutter. Se fija en blanco porque la app es de tema claro; con
         "?android:colorBackground" se ve un parpadeo negro en modo oscuro. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fondo_arranque</item>
    </style>
</resources>
