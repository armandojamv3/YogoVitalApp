skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam rectangle {
  BackgroundColor #EAF2FB
  BorderColor #5B9EF5
  BorderThickness 1.5
}

title Diagrama de Arquitectura en Capas — Yogo Vital

